# Read server-side at runtime — safe to set via `docker run -e` / compose
# `environment:`.
API_BASE_URL=http://localhost:3000
RESEND_API_KEY=

# Inlined into the client bundle at `next build` time — not readable at
# container runtime. If you're building a Docker image, pass these as build
# args (--build-arg NEXT_PUBLIC_API_URL=...), not just `docker run -e`.
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_ASSETS_URL=
NEXT_PUBLIC_PAYMONGO_PUBLIC_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_APP_ENV=development
